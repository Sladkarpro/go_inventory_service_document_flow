# Окружение приложения (dev / prod)
ENV=dev

# Порт HTTP-сервера микросервиса
# 8085 занят канбаном, 8086 - notification_service
SERVER_PORT=8087

# Путь к публичному ключу RSA для проверки подписи JWT (относительно cmd/ или абсолютный)
# В Docker путь переопределяется на /config/jwt/public.pem в docker-compose.yml
JWT_PUBLIC_KEY_PATH=../config/jwt/public.pem

# Подключение к базе данных PostgreSQL (БД складского учёта)
# DB_PORT=5434, потому что 5432 занят Symfony, а 5433 - канбаном
DB_HOST=localhost
DB_PORT=5434
DB_USER=root
DB_PASSWORD=password
DB_NAME=warehouse_db

WAREHOUSE_DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Конфигурация для утилиты goose (чтобы работала команда `goose up`)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${WAREHOUSE_DB_URL}
GOOSE_MIGRATION_DIR=migrations

# Подключение к RabbitMQ для синхронизации справочника пользователей (реплики users)
# Для запуска локально на хосте: amqp://guest:guest@localhost:5672/
# Для запуска в Docker-сети:   amqp://guest:guest@rabbitmq:5672/
RABBITMQ_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/
RABBITMQ_EVENTS_EXCHANGE=events
RABBITMQ_USER_SYNC_QUEUE=warehouse.user_sync

# Внутренний HTTP-доступ к монолиту Symfony (server-to-server)
SYMFONY_INTERNAL_API_URL=http://nginx_web:80
SYMFONY_INTERNAL_API_KEY=change-me

# Ключ шифрования учётных данных оборудования: 32 байта в base64.
# ВНИМАНИЕ: Для продакшена сгенерировать свой: openssl rand -base64 32
# Потеря ключа = сохранённые пароли устройств расшифровать невозможно.
WAREHOUSE_CREDENTIALS_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=
